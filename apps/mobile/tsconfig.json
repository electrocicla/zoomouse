{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "strict": true,
    "types": [],
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["App.tsx", "src/**/*.ts", "src/**/*.tsx"]
}
